@startuml
left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial

rectangle "采集\n可信来源与范围" as G #DDEBFF
rectangle "提炼\n基于来源提问、摘要" as R #E8F5E9
rectangle "连接\n关联已有笔记与判断" as L #E2D9F3
rectangle "核对\n回原文验证证据" as V #F8D7DA
rectangle "内化\n问猜跑看讲测" as I #FFF3CD
rectangle "复用\n考试、文章、方案、决策" as A #D9F0F5

G --> R : 圈定范围
R --> L : 沉淀
L --> V : 检查证据
V --> I : 证据可靠
I --> A : 变成能力
V --> R : 证据不足,继续追问
A --> G : 新问题与新资料
@enduml
